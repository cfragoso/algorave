ALGORAVE_API_URL=http://127.0.0.1:3000
ALGORAVE_TRANSFORMS_PORT=8081
# Set the same token as the Algorave app when API authentication is configured.
ALGORAVE_TOKEN=
# Optional existing trusted TLS certificate pair. Otherwise .local/ is generated.
# ALGORAVE_TLS_CERT=/absolute/path/server.crt
# ALGORAVE_TLS_KEY=/absolute/path/server.key
